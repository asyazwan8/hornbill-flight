# Supabase project that backs the online leaderboard. Copy this file to `.env`
# (or `.env.local`) and fill in both values, which you will find in the
# Supabase dashboard under Project Settings -> API.
#
# Leave them unset and the game still plays exactly as before: the leaderboard
# hides itself and your best score is kept in the browser instead.
#
# The anon key is meant to be public -- it ships inside the browser bundle, and
# what it may do is decided by the row level security policies in
# supabase/schema.sql. Never put the service role key in here; it bypasses
# those policies entirely.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
