# Load the MediaPipe runtime and pose model from the official CDN instead of
# from public/. Useful for hosts where shipping ~17MB of static assets is
# inconvenient. Copy to .env.production to activate for `npm run build`.
VITE_MEDIAPIPE_WASM=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.0.1/wasm
VITE_POSE_MODEL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task
